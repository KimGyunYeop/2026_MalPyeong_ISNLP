# =====================================================================
# 2026 국립국어원 AI 말평 — 글쓰기 채점 능력 평가
# 최종 제출본 재현에 필요한 것만 올린다.
#
# 원칙
#   1. 대회 데이터는 절대 올리지 않는다 (배포 금지 자료).
#   2. 모델 가중치·체크포인트·이미지 staging은 올리지 않는다 (수백 GB).
#   3. 실험 산출물(results/)과 다른 설정의 실험 기록은 올리지 않는다.
#   4. 최종 제출본에 쓰이지 않은 실험 트리는 올리지 않는다.
# =====================================================================

# ---- 파이썬/도구 부산물 ------------------------------------------------
__pycache__/
*.py[cod]
.venv*/
.cache/
.ruff_cache/
.pytest_cache/
.snapshots/
*.tmp
*.tmp.*
*.log
*.out

# ---- 대회 데이터 (배포 금지) -------------------------------------------
datasets/
**/processed_dataset/
**/prepared_extended_data*/
*.jsonl
!code_for_docker_check_otherserv/data/README.md
download_logs/

# ---- 모델 가중치와 체크포인트 -----------------------------------------
**/*checkpoint*/
**/checkpoints/
**/trainer_checkpoints/
**/final_adapter/
**/adapter/*
!**/adapter/.gitkeep
!**/adapter/README.md
**/model/*
!**/model/README.md
*.safetensors
*.ckpt
*.pt
*.pth
*.onnx
*.gguf
pytorch_model*.bin
adapter_model*.bin
model-*.bin
optimizer*.bin

# ---- 빌드 staging / 백업 / 임시 ---------------------------------------
/submission_assets/
/backup/
/backups/
# 로컬 검토 기록: 코드 사본, 로그, PDF 추출 이미지, 검증 JSON과 백업.
/audit*/
# 로컬 정리 문서와 보조 도구. 공개 실행 경로는 기존 train.py/docker_release.sh를 사용한다.
/reproduction/
/reproduce_report.sh
/main_code_submission/manifests/report_abcd.template.json
/tmp_trashcan*/
/tmp_trash_can*/
*trash*

# ---- 실험 산출물 -------------------------------------------------------
# 기술서 설정의 채점/근거 학습 출력. 실행 설정 JSON은 별도 경로에 둔다.
/results/
main_code/results/
main_code_relonation/results/
main_code_submission/results/
code_for_docker_check_otherserv/results/

# ---- 최종 제출본에 쓰이지 않은 실험 트리 -------------------------------
# 3단계(분석 생성 -> 채점) 실험. 근거 무기여가 공식 400편에서 확인되어 제출본에
# 들어가지 않았다. README의 "채택하지 않은 축"에 결론만 남긴다.
/main_code_analysis_3stage_opt/
/main_code_analysis_3stage_opt_offline_custom/
/main_code_for_submssion_3stage/
/main_proposed_regression_base/
# 타 팀 이미지 감사. 채점에 쓸 것이 없다는 결론만 남기고 산출물은 올리지 않는다.
/competitor_docker_audit/

# ---- 자격증명 ----------------------------------------------------------
.env
.env.*
!.env.example
.netrc
.npmrc
*.pem
*.key
*.p12
*.pfx
credentials*.json

